# Copy to .env for Docker Compose. Supply locally generated values; never commit .env.
DB_PASSWORD=
# Base64-encoded random bytes: minimum 32 decoded bytes for HS256.
JWT_SECRET=
SPRING_PROFILES_ACTIVE=demo
# Explicit opt-in: enables local administrator bootstrap and one-time demo funding.
DEMO_ENABLED=false
DEMO_ADMIN_EMAIL=
# Unique local password, 12-72 ASCII characters. Remove after first bootstrap.
DEMO_ADMIN_PASSWORD=
API_DOCS_ENABLED=true
